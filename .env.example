# Copiar como .env.local en desarrollo. Todas son de BUILD: quedan escritas en
# el HTML/JS estático, así que nada de secretos acá.

# Nombre del sitio (encabezado, título de las páginas, emails los arma la API).
NEXT_PUBLIC_SITE_NAME=TallerScan

# URL pública, sin barra final (para metadatos y links absolutos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dónde está la API. En desarrollo, la API corre aparte (localhost:5100). En
# producción va VACÍA: web y API comparten origen a través de nginx (/api).
NEXT_PUBLIC_API_URL=http://localhost:5100

# Opcional: URL de la API para leer precios y datos del taller al compilar
# (así el HTML ya trae el tarifario aunque la API esté caída). Sin ella, la web
# los pide al abrirse.
BUILD_API_URL=http://localhost:5100

# Paletas: NEXT_PUBLIC_PALETA = blanco | cemento | plano | franjas | oscuro (la de todos; la elegida es "oscuro").
# NEXT_PUBLIC_MOSTRAR_PALETAS=1 muestra el selector flotante para comparar (solo en desarrollo).
NEXT_PUBLIC_PALETA=oscuro
NEXT_PUBLIC_MOSTRAR_PALETAS=0
